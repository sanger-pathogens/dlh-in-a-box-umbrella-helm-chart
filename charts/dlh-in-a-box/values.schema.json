{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "dlh-in-a-box umbrella values schema",
  "type": "object",
  "additionalProperties": true,
  "definitions": {
    "catalogAcl": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "read": {
          "type": "array",
          "items": { "type": "string" }
        },
        "write": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "identityContract": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable the shared external identity contract used by Trino and the optional UI integrations."
        },
        "external": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "oidc": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "issuer": { "type": "string" },
                "usernameClaim": { "type": "string" },
                "groupsClaim": { "type": "string" },
                "userMappingPattern": { "type": "string" },
                "processForwardedHeaders": { "type": "boolean" },
                "scopes": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            },
            "clients": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "trino": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "enabled": { "type": "boolean" },
                    "clientId": { "type": "string" },
                    "existingSecret": { "type": "string" },
                    "clientSecretKey": { "type": "string" },
                    "sharedSecretExistingSecret": { "type": "string" },
                    "sharedSecretKey": { "type": "string" }
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": { "enabled": { "const": true } },
                        "required": ["enabled"]
                      },
                      "then": {
                        "required": [
                          "clientId",
                          "existingSecret",
                          "sharedSecretExistingSecret"
                        ]
                      }
                    }
                  ]
                },
                "superset": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "enabled": { "type": "boolean" },
                    "clientId": { "type": "string" },
                    "existingSecret": { "type": "string" },
                    "clientSecretKey": { "type": "string" },
                    "authorizeUrl": { "type": "string" },
                    "accessTokenUrl": { "type": "string" },
                    "apiBaseUrl": { "type": "string" },
                    "jwksUri": { "type": "string" },
                    "userInfoUrl": { "type": "string" },
                    "providerName": { "type": "string" },
                    "roleKeysPath": { "type": "string" }
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": { "enabled": { "const": true } },
                        "required": ["enabled"]
                      },
                      "then": {
                        "required": [
                          "clientId",
                          "existingSecret",
                          "authorizeUrl",
                          "accessTokenUrl",
                          "apiBaseUrl",
                          "jwksUri",
                          "userInfoUrl"
                        ]
                      }
                    }
                  ]
                },
                "datahub": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "enabled": { "type": "boolean" },
                    "provider": { "type": "string" },
                    "clientId": { "type": "string" },
                    "existingSecret": { "type": "string" },
                    "clientSecretKey": { "type": "string" },
                    "discoveryUri": { "type": "string" },
                    "scope": { "type": "string" },
                    "userNameClaim": { "type": "string" },
                    "userNameClaimRegex": { "type": "string" }
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": { "enabled": { "const": true } },
                        "required": ["enabled"]
                      },
                      "then": {
                        "required": [
                          "clientId",
                          "existingSecret",
                          "discoveryUri"
                        ]
                      }
                    }
                  ]
                },
                "prefectProxy": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "enabled": { "type": "boolean" },
                    "clientId": { "type": "string" },
                    "existingSecret": { "type": "string" },
                    "clientSecretKey": { "type": "string" },
                    "cookieExistingSecret": { "type": "string" },
                    "cookieSecretKey": { "type": "string" },
                    "redirectUrl": { "type": "string" },
                    "allowedGroups": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "emailDomains": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "ingress": {
                      "type": "object",
                      "additionalProperties": true,
                      "properties": {
                        "enabled": { "type": "boolean" },
                        "className": { "type": "string" },
                        "host": { "type": "string" },
                        "tlsSecretName": { "type": "string" },
                        "annotations": {
                          "type": "object",
                          "additionalProperties": true
                        }
                      }
                    }
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": { "enabled": { "const": true } },
                        "required": ["enabled"]
                      },
                      "then": {
                        "required": [
                          "clientId",
                          "existingSecret",
                          "redirectUrl"
                        ]
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "directory": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "ldap": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "enabled": { "type": "boolean" },
                "url": { "type": "string" },
                "userBaseDn": { "type": "string" },
                "userSearchFilter": { "type": "string" },
                "groupNameAttribute": { "type": "string" },
                "useGroupFilter": { "type": "boolean" },
                "groupBaseDn": { "type": "string" },
                "groupSearchFilter": { "type": "string" },
                "groupSearchMemberAttribute": { "type": "string" },
                "userMemberOfAttribute": { "type": "string" },
                "bindDistinguishedName": { "type": "string" },
                "bindExistingSecret": { "type": "string" },
                "bindPasswordKey": { "type": "string" },
                "allowInsecure": { "type": "boolean" }
              },
              "allOf": [
                {
                  "if": {
                    "properties": { "enabled": { "const": true } },
                    "required": ["enabled"]
                  },
                  "then": {
                    "required": [
                      "url",
                      "userBaseDn",
                      "bindDistinguishedName",
                      "bindExistingSecret"
                    ]
                  }
                }
              ]
            }
          }
        },
        "groupConventions": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "appAccessPrefix": { "type": "string" },
            "rolePrefix": { "type": "string" },
            "dataPrefix": { "type": "string" }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "enabled": { "const": true } },
            "required": ["enabled"]
          },
          "then": {
            "required": ["external", "directory"]
          }
        }
      ]
    }
  },
  "properties": {
    "identity": {
      "$ref": "#/definitions/identityContract",
      "description": "Human-facing shared identity contract. Mirror this into global.identity in consumer values so subcharts can read it."
    },
    "global": {
      "description": "Cross-cutting settings shared across the umbrella chart, including storage and catalog definitions.",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "nameOverride": {
          "type": "string",
          "description": "Override the chart name used in generated Kubernetes resource names."
        },
        "fullnameOverride": {
          "type": "string",
          "description": "Override the fully qualified release name used in generated Kubernetes resource names."
        },
        "domain": {
          "type": "string",
          "description": "Base domain used by components that generate hostnames, such as optional Hive ingress resources."
        },
        "environment": {
          "type": "string",
          "description": "Short environment label used to distinguish local, development, or production-style deployments.",
          "pattern": "^[a-zA-Z0-9-]*$"
        },
        "imagePullSecrets": {
          "type": "array",
          "description": "Image pull secret references shared across components that honor the global value.",
          "items": {
            "type": "object"
          }
        },
        "identity": {
          "$ref": "#/definitions/identityContract",
          "description": "Runtime copy of the shared identity contract consumed by subcharts."
        },
        "storage": {
          "description": "Object-store configuration shared by locally owned composition logic and downstream components.",
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "backend": {
              "type": "string",
              "description": "Select whether the deployment uses an external S3-compatible object store or the in-cluster MinIO dependency.",
              "enum": ["externalS3", "minio"]
            },
            "s3": {
              "description": "Connection and credential settings for the S3-compatible object-store endpoint.",
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "endpoint": {
                  "type": "string",
                  "description": "S3-compatible endpoint URL, for example the MinIO service or an external object-store endpoint."
                },
                "region": {
                  "type": "string",
                  "description": "Logical region for the configured object store."
                },
                "bucket": {
                  "type": "string",
                  "description": "Primary bucket used by local examples and generated catalog wiring."
                },
                "pathStyleAccess": {
                  "type": "boolean",
                  "description": "Enable path-style S3 access, which is commonly required for MinIO and some S3-compatible endpoints."
                },
                "accessKey": {
                  "type": "string",
                  "description": "Inline access key used by example overlays or simple local deployments."
                },
                "secretKey": {
                  "type": "string",
                  "description": "Inline secret key used by example overlays or simple local deployments."
                },
                "existingSecret": {
                  "type": "string",
                  "description": "Existing Kubernetes Secret name containing object-store credentials for chart renders that read secrets from the cluster."
                },
                "accessKeyKey": {
                  "type": "string",
                  "description": "Secret key name to read the access key from when external secret delivery is used."
                },
                "secretKeyKey": {
                  "type": "string",
                  "description": "Secret key name to read the secret key from when external secret delivery is used."
                }
              }
            }
          }
        },
        "dataCatalogs": {
          "description": "Catalog definitions that drive generated Trino catalogs, ACLs, and per-catalog Hive metastore resources.",
          "type": "object",
          "patternProperties": {
            ".*": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "type": {
                  "type": "string",
                  "description": "Logical catalog type used by the local Trino and Hive composition logic.",
                  "enum": ["deltaLake", "hive"]
                },
                "authorizedGroups": {
                  "description": "Preferred catalog-level group access lists used by generated Trino access rules.",
                  "$ref": "#/definitions/catalogAcl"
                },
                "authorizedUsers": {
                  "description": "Simple catalog-level access-control lists used by generated Trino access rules.",
                  "$ref": "#/definitions/catalogAcl"
                }
              }
            }
          }
        }
      }
    },
    "trino": {
      "description": "Pass-through values for the vendored Trino chart plus the top-level enablement flag.",
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "prefect": {
      "description": "Feature toggles for the Prefect server and worker subcomponents.",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "server": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" }
          }
        },
        "workers": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" }
          }
        },
        "authProxy": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" }
          }
        }
      }
    },
    "prefectServer": {
      "description": "Direct pass-through values for the upstream Prefect Server chart.",
      "type": "object",
      "additionalProperties": true
    },
    "prefectWorker": {
      "description": "Direct pass-through values for the upstream Prefect Worker chart.",
      "type": "object",
      "additionalProperties": true
    },
    "prefect-auth-proxy": {
      "description": "Pass-through values for the oauth2-proxy dependency that can protect Prefect in shared environments.",
      "type": "object",
      "additionalProperties": true
    },
    "sparkOperator": {
      "description": "Pass-through values for the Spark Operator dependency.",
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "nameOverride": { "type": "string" }
      }
    },
    "minio": {
      "description": "Pass-through values for the MinIO dependency used in local and self-contained deployments.",
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "datahub": {
      "description": "Pass-through values for the optional DataHub dependency.",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "auth": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "groupProvisioning": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "enabled": { "type": "boolean" },
                "groupsClaim": { "type": "string" },
                "viewers": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "editors": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "datahubPrerequisites": {
      "description": "Pass-through values for the DataHub prerequisites chart deployed alongside DataHub.",
      "type": "object",
      "additionalProperties": true
    },
    "superset": {
      "description": "Pass-through values for the optional Apache Superset dependency plus the top-level enablement flag.",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "auth": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "roleMappings": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "hive": {
      "description": "Settings for the locally owned Hive metastore subchart.",
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "metastore": {
          "description": "Container image settings for the Hive metastore runtime.",
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "image": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "registry": { "type": "string" },
                "repository": { "type": "string" },
                "tag": { "type": "string" }
              }
            }
          }
        },
        "schemainit": {
          "description": "Container image and optional hook-job settings for Hive schema initialization.",
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "image": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "registry": { "type": "string" },
                "repository": { "type": "string" },
                "tag": { "type": "string" }
              }
            },
            "job": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "enabled": { "type": "boolean" }
              }
            }
          }
        },
        "postgres": {
          "description": "PostgreSQL connectivity for Hive metadata databases.",
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "host": { "type": "string" },
            "port": { "type": "string" },
            "username": { "type": "string" },
            "password": { "type": "string" },
            "existingSecret": { "type": "string" }
          }
        },
        "s3": {
          "description": "S3 connectivity used by Hive metastore instances when reading and writing warehouse data.",
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "endpoint": { "type": "string" },
            "accessKey": { "type": "string" },
            "secretKey": { "type": "string" },
            "pathStyleAccess": { "type": "boolean" },
            "existingSecret": { "type": "string" }
          }
        },
        "warehouseDir": {
          "type": "string",
          "description": "Base warehouse directory under which per-catalog locations are created."
        },
        "ingress": {
          "description": "Optional ingress settings for exposing Hive metastore services.",
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "className": { "type": "string" },
            "tlsSecretName": { "type": "string" }
          }
        }
      }
    },
    "vault": {
      "description": "Pass-through values for the Vault dependency.",
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "hivePostgresql": {
      "description": "Pass-through values for the PostgreSQL dependency used by the Hive subchart.",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "nameOverride": { "type": "string" }
      }
    }
  },
  "required": [
    "global",
    "trino",
    "prefect",
    "sparkOperator",
    "minio",
    "datahub",
    "hive",
    "vault"
  ]
}
