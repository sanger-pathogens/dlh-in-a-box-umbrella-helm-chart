{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "dlh-in-a-box umbrella values schema",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "nameOverride": { "type": "string" },
        "fullnameOverride": { "type": "string" },
        "domain": { "type": "string" },
        "environment": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9-]*$"
        },
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "storage": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "backend": {
              "type": "string",
              "enum": ["externalS3", "minio"]
            },
            "s3": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "endpoint": { "type": "string" },
                "region": { "type": "string" },
                "bucket": { "type": "string" },
                "pathStyleAccess": { "type": "boolean" },
                "accessKey": { "type": "string" },
                "secretKey": { "type": "string" },
                "accessKeyKey": { "type": "string" },
                "secretKeyKey": { "type": "string" }
              }
            }
          }
        },
        "dataCatalogs": {
          "type": "object",
          "patternProperties": {
            ".*": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "type": {
                  "type": "string",
                  "enum": ["deltaLake", "hive"]
                },
                "authorizedUsers": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "read": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "write": {
                      "type": "array",
                      "items": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "trino": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "prefect": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "server": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" }
          }
        },
        "workers": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" }
          }
        }
      }
    },
    "prefectServer": {
      "type": "object",
      "additionalProperties": true
    },
    "prefectWorker": {
      "type": "object",
      "additionalProperties": true
    },
    "sparkOperator": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "nameOverride": { "type": "string" }
      }
    },
    "minio": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "datahub": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "datahubUpstream": {
      "type": "object",
      "additionalProperties": true
    },
    "hive": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "metastore": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "image": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "registry": { "type": "string" },
                "repository": { "type": "string" },
                "tag": { "type": "string" }
              }
            }
          }
        },
        "schemainit": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "image": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "registry": { "type": "string" },
                "repository": { "type": "string" },
                "tag": { "type": "string" }
              }
            },
            "job": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "enabled": { "type": "boolean" }
              }
            }
          }
        },
        "postgres": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "host": { "type": "string" },
            "port": { "type": "string" },
            "username": { "type": "string" },
            "password": { "type": "string" },
            "existingSecret": { "type": "string" }
          }
        },
        "s3": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "endpoint": { "type": "string" },
            "accessKey": { "type": "string" },
            "secretKey": { "type": "string" },
            "pathStyleAccess": { "type": "boolean" },
            "existingSecret": { "type": "string" }
          }
        },
        "warehouseDir": { "type": "string" },
        "ingress": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "className": { "type": "string" },
            "tlsSecretName": { "type": "string" }
          }
        }
      }
    },
    "vault": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "postgresql": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "nameOverride": { "type": "string" }
      }
    }
  },
  "required": [
    "global",
    "trino",
    "prefect",
    "sparkOperator",
    "minio",
    "datahub",
    "hive",
    "vault"
  ]
}
